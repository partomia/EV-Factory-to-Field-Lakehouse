{
 "entity": "cell_qc_inspection",
 "source": "cell_qc",
 "format": "psv",
 "file_glob": "*.csv",
 "trailer": "TRL",
 "description": "Inline QC verdicts (X-ray per cell, film vision per electrode segment); trailer TRL|<data rows>",
 "key": [
  "cell_id",
  "inspection"
 ],
 "columns": [
  {
   "name": "cell_id",
   "type": "string",
   "required": true
  },
  {
   "name": "batch_id",
   "type": "string",
   "required": true,
   "pattern": "^CBCL[12][0-9]{6}[ABC]$",
   "severity": "reject"
  },
  {
   "name": "line",
   "type": "string",
   "required": true,
   "allowed": [
    "CL1",
    "CL2"
   ]
  },
  {
   "name": "inspection",
   "type": "string",
   "required": true,
   "allowed": [
    "XRAY",
    "FILM"
   ],
   "severity": "reject"
  },
  {
   "name": "station",
   "type": "string",
   "required": true
  },
  {
   "name": "inspected_ts",
   "type": "timestamp",
   "required": true,
   "formats": [
    "yyyy-MM-dd'T'HH:mm:ssXXX"
   ]
  },
  {
   "name": "verdict",
   "type": "string",
   "required": true,
   "allowed": [
    "PASS",
    "FAIL"
   ],
   "severity": "reject"
  },
  {
   "name": "defect_code",
   "type": "string"
  },
  {
   "name": "score",
   "type": "double",
   "required": true
  },
  {
   "name": "bbox",
   "type": "string"
  },
  {
   "name": "image_ref",
   "type": "string"
  }
 ]
}
