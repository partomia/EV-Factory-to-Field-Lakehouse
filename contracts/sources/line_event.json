{
 "entity": "line_event",
 "source": "line_event",
 "format": "csv",
 "file_glob": "*.csv",
 "description": "Line PLC / MES station cycle events (twin domain): one row per completed station cycle, one CSV per line per business date (the IST date of mes_ts); timestamps on the station clock except mes_ts (MES server); same fields as Kafka evx.factory.line",
 "key": [
  "event_id"
 ],
 "columns": [
  {
   "name": "event_id",
   "type": "string",
   "required": true,
   "pattern": "^(CA|PA|VA)-[A-Z]{3}-[0-9]{2}-[0-9]{8}-[0-9]{6}$",
   "severity": "reject"
  },
  {
   "name": "station_id",
   "type": "string",
   "required": true,
   "pattern": "^(CA|PA|VA)-[A-Z]{3}-[0-9]{2}$",
   "severity": "reject"
  },
  {
   "name": "line_id",
   "type": "string",
   "required": true,
   "allowed": [
    "CL1",
    "CL2",
    "PL1",
    "PL2",
    "VA1",
    "VA2"
   ],
   "severity": "reject"
  },
  {
   "name": "area",
   "type": "string",
   "required": true,
   "allowed": [
    "CELL",
    "PACK",
    "VEHICLE"
   ]
  },
  {
   "name": "unit_id",
   "type": "string",
   "required": true
  },
  {
   "name": "cycle_start_ts",
   "type": "timestamp",
   "required": true,
   "formats": [
    "yyyy-MM-dd'T'HH:mm:ssXXX"
   ]
  },
  {
   "name": "event_ts",
   "type": "timestamp",
   "required": true,
   "formats": [
    "yyyy-MM-dd'T'HH:mm:ssXXX"
   ]
  },
  {
   "name": "mes_ts",
   "type": "timestamp",
   "required": true,
   "formats": [
    "yyyy-MM-dd'T'HH:mm:ssXXX"
   ]
  },
  {
   "name": "cycle_s",
   "type": "double",
   "required": true,
   "min": 0
  },
  {
   "name": "status",
   "type": "string",
   "required": true,
   "allowed": [
    "OK",
    "FAULT",
    "BLOCKED",
    "STARVED"
   ],
   "severity": "reject"
  },
  {
   "name": "shift",
   "type": "string",
   "required": true,
   "allowed": [
    "A",
    "B",
    "C"
   ]
  }
 ]
}
