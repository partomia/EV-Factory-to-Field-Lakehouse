{
 "topic": "evx.vehicle.dtc",
 "table": "vehicle_dtc_event",
 "description": "Live-subset diagnostic trouble codes on live business dates (batch dtc_history ends at the history end; no overlap). NiFi routes THERMAL codes and CRITICAL severity to evx.alert.priority (synthetic)",
 "fields": [
  {
   "name": "event_id",
   "type": "string",
   "required": true,
   "pattern": "^DTS-[A-HJ-NPR-Z0-9]{17}-[0-9]{8}-[0-9]{2}$"
  },
  {
   "name": "vin",
   "type": "string",
   "required": true,
   "pattern": "^[A-HJ-NPR-Z0-9]{17}$"
  },
  {
   "name": "event_ts",
   "type": "timestamp",
   "required": true
  },
  {
   "name": "dtc_code",
   "type": "string",
   "required": true,
   "allowed": [
    "ABS-W30",
    "BMS-I02",
    "BMS-T01",
    "CHG-C05",
    "MCU-T10",
    "MOT-E21"
   ]
  },
  {
   "name": "dtc_desc",
   "type": "string",
   "required": true
  },
  {
   "name": "severity",
   "type": "string",
   "required": true,
   "allowed": [
    "LOW",
    "MEDIUM",
    "HIGH",
    "CRITICAL"
   ]
  },
  {
   "name": "odo_km",
   "type": "double",
   "required": true
  },
  {
   "name": "fw_bms",
   "type": "string",
   "required": true,
   "pattern": "^BMS-[0-9.]+(-F)?$"
  },
  {
   "name": "producer_run",
   "type": "string",
   "required": true
  }
 ]
}
